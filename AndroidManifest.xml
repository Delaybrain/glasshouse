<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.delaybrain.glasshouse" android:versionCode="17" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <!-- Only for the network tile: Wi-Fi, Ethernet or offline, and the Wi-Fi signal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 11+ only shows apps a home screen asks to see: TV apps and normal apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings screens the network tile and the Bluetooth, Sound and Picture shortcuts open. -->
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="com.google.android.intent.action.CONNECT_INPUT" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <package android:name="com.tcl.settings" />
        <!-- Google TV's HDMI input player, so HDMI tiles can see when the TV sends HDMI to it. -->
        <package android:name="com.google.android.tv.inputplayer" />
        <!-- The TV's other home screens, which HomeGuard steps in front of. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Live TV apps the channel and number buttons open. -->
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.android.tv" />
        <package android:name="com.droidlogic.android.tv" />
        <!-- Google's voice search: with it off, HomeGuard closes the voice remote pairing page. -->
        <package android:name="com.google.android.katniss" />
    </queries>
    <!-- Android 12+: the Bluetooth shortcut and Control Center open the TV's pairing screen, which needs it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The recent row under the top shelf: which apps were used last. Granted over adb only:
         adb shell appops set com.delaybrain.glasshouse GET_USAGE_STATS allow -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- The sleep setting in Control Center. Granted over adb only, never at install; without it the
         row isn't there: adb shell pm grant com.delaybrain.glasshouse android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- The screensaver wait in Control Center: adb shell appops set com.delaybrain.glasshouse WRITE_SETTINGS allow -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Lets "Uninstall" in the app menu open Android's uninstall prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Sending photos from a phone in the same Wi-Fi (PhotoDrop's little web server, only while its card is up). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Settings > Wallpaper/Screensaver > Delete photos: with it (install.sh allows it over adb), a photo
         is deleted after Glasshouse's own question, without Android asking a second time. -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <!-- Photos for the screensaver (USB stick or the TV), asked for when that look is picked. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Glasshouse" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- The remote's Settings button (through HomeGuard): a panel over whatever is playing. Its own
             task affinity, so opening it doesn't bring the home screen to the front behind it. -->
        <activity android:name=".ControlCenter"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:taskAffinity="com.delaybrain.glasshouse.control"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />
        <!-- The screensaver: pick it in Settings > System > Ambient mode, or with
             adb shell settings put secure screensaver_components com.delaybrain.glasshouse/.Screensaver -->
        <activity android:name=".SaverPreview"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <service android:name=".Screensaver"
            android:label="Glasshouse"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Off until turned on (homeguard.sh): brings this home screen up over Google TV's. -->
        <service android:name=".HomeGuard"
            android:label="Glasshouse: remote buttons"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/homeguard" />
        </service>
    </application>
</manifest>
